<?xml version="1.0" encoding="utf-8"?>
<!-- A CD with a wrench across it and a check badge: fixing your rips. Same CD and badge as AddMyCoverArt, so the
     two read as a family. 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:scaleX="1.15" android:scaleY="1.15" android:pivotX="54" android:pivotY="54">
    <!-- disc -->
    <path android:fillColor="#D9DEE6" android:pathData="M24,52 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0" />
    <!-- rainbow sheen -->
    <path android:fillColor="#9FD3F2" android:pathData="M46,52 L46,32 A20,20 0 0,1 63,42 Z" />
    <path android:fillColor="#F2B8D8" android:pathData="M46,52 L28,62 A20,20 0 0,0 38,70.5 Z" />
    <!-- hub and hole -->
    <path android:fillColor="#A7B0BC" android:pathData="M38,52 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <path android:fillColor="#1F2430" android:pathData="M43,52 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
    <!-- wrench: drawn pointing right from (0,0), then turned to run from lower left to upper right -->
    <group android:rotation="-45" android:translateX="50" android:translateY="67">
        <path android:fillColor="#F0A63C" android:strokeColor="#1F2430" android:strokeWidth="1.6"
            android:strokeLineJoin="round"
            android:pathData="M3,-3 h26 v6 h-26 a3,3 0 0,1 0,-6 z" />
        <path android:fillColor="#F0A63C" android:strokeColor="#1F2430" android:strokeWidth="1.6"
            android:strokeLineJoin="round"
            android:pathData="M40.42,-3 A8,8 0 1,0 40.42,3 L36,3 L36,-3 Z" />
    </group>
    <!-- check badge -->
    <path android:fillColor="#1F2430" android:pathData="M61,68 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
    <path android:fillColor="#3CC46E" android:pathData="M63,68 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="2.2" android:strokeLineCap="round"
        android:strokeLineJoin="round" android:pathData="M66.8,68.2 L69.8,71.2 L75.4,65" />
    </group>
</vector>
